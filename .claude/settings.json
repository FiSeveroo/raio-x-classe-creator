{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/trava-main.js\"",
            "timeout": 10,
            "statusMessage": "Conferindo trava do main"
          }
        ]
      }
    ]
  }
}
