# Copie para .env.local e preencha. NUNCA commitar o .env.local.
# Na Vercel: Settings → Environment Variables (mesmos nomes).

# Supabase — só a chave publicável (anon). A chave secreta NÃO é usada pelo
# Next.js (ver CLAUDE.md: escrita com a mesma permissão que o Streamlit tinha).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# APIs dos módulos
YOUTUBE_API_KEY=
ANTHROPIC_API_KEY=

# Cloudflare Turnstile (anti-robô). Sem as duas, o portão fica desligado.
# A chave pública só funciona nos domínios cadastrados no widget da Cloudflare.
# Em `next dev`, o .env.development.local usa as chaves de teste da Cloudflare.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Painel interno do Termômetro (/termometro?aba=exportar). Vazia = painel ABERTO.
SENHA_PAINEL_INTERNO=

# URL pública (Open Graph / links absolutos)
NEXT_PUBLIC_SITE_URL=https://raiox.classecreator.com

# Indexação no Google: só "true" depois da virada para o domínio oficial.
PERMITIR_INDEXACAO=
